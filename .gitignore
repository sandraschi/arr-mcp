# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.egg

# uv
# NOTE: uv.lock is COMMITTED per fleet standard (reproducible installs) - do NOT ignore it.

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# Mypy
.mypy_cache/

# Env
.env

# Node
webapp/node_modules/
webapp/dist/
webapp/.vite/
webapp/playwright-report/
webapp/test-results/
webapp/blob-report/

# Tauri
native/target/
native/gen/
native/binaries/
native/resources/*.exe

# Runtime logs
*.log


# MCPB build artifact -- staging copy of src/, regenerated by mcpb/pack.ps1
# on every pack. Never hand-edit, never commit.
mcpb/src/

# MCPB distributables (built by scripts/mcpb-pack.ps1 into dist/)
*.mcpb

# Batch-edit safety backups (see Batch Mutation Safety rule)
*.bak
*.bak.*

# Assfix working snapshots (regenerable; committed copy lives in docs/assess-reports/)
reports/
