{
  "manifest_version": "0.2",
  "name": "arr-mcp",
  "version": "1.0.0",
  "description": "FastMCP 3.3+ MCP server for the complete *arr automation stack",
  "author": {
    "name": "sandraschi"
  },
  "server": {
    "type": "python",
    "entry_point": "src/arr_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "python",
        "-m",
        "arr_mcp"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/src",
        "PYTHONUNBUFFERED": "1",
        "MCP_TRANSPORT": "stdio"
      }
    }
  },
  "tools": [
    {
      "name": "radarr_movies",
      "description": "Movie lifecycle (list, lookup, add, delete, update, import)"
    },
    {
      "name": "sonarr_series",
      "description": "Series lifecycle (list, lookup, add, delete, update)"
    },
    {
      "name": "sonarr_episodes",
      "description": "Episode management (list, get, search, set_monitored)"
    },
    {
      "name": "lidarr_artists",
      "description": "Artist lifecycle (list, lookup, add, delete, update)"
    },
    {
      "name": "lidarr_albums",
      "description": "Album management (list, get, lookup, set_monitored)"
    },
    {
      "name": "readarr_authors",
      "description": "Author lifecycle (list, lookup, add, delete, update)"
    },
    {
      "name": "readarr_books",
      "description": "Book management (list, get, lookup, set_monitored)"
    },
    {
      "name": "prowlarr_indexers",
      "description": "Indexer lifecycle (list, get, add, update, delete, test)"
    },
    {
      "name": "prowlarr_search",
      "description": "Unified search across all indexers"
    },
    {
      "name": "prowlarr_applications",
      "description": "Connected *arr app management"
    },
    {
      "name": "prowlarr_history",
      "description": "Indexer history and statistics"
    },
    {
      "name": "bazarr_subtitles",
      "description": "Subtitle search, download, history"
    },
    {
      "name": "overseerr_requests",
      "description": "Media request management (list, approve, decline)"
    },
    {
      "name": "overseerr_search",
      "description": "Search Overseerr"
    },
    {
      "name": "overseerr_users",
      "description": "Overseerr user management"
    },
    {
      "name": "arr_orchestrate",
      "description": "Cross-arr orchestration with media-server availability check"
    },
    {
      "name": "arr_calendar",
      "description": "Unified calendar across all arrs"
    },
    {
      "name": "arr_stats",
      "description": "Consolidated stack statistics"
    },
    {
      "name": "arr_health",
      "description": "Stack-wide health probe"
    },
    {
      "name": "arr_shutdown",
      "description": "Graceful server shutdown"
    },
    {
      "name": "arr_help",
      "description": "Tool discovery and quickstart"
    },
    {
      "name": "arr_agentic",
      "description": "LLM-powered cross-arr workflows"
    },
    {
      "name": "arr_health_card",
      "description": "Rich health card (Prefab UI)"
    },
    {
      "name": "arr_calendar_card",
      "description": "Rich calendar card (Prefab UI)"
    },
    {
      "name": "arr_stats_card",
      "description": "Rich stats card (Prefab UI)"
    }
  ]
}
